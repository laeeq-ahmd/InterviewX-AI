# Root .env — read by Docker Compose automatically for ${VAR} substitution in docker-compose.yml
# Copy this to .env and fill in your values.
# This file only contains FRONTEND build-time variables.
# Backend secrets stay in server/.env

# Leave empty for Docker (nginx proxies /api). Set to domain on EC2 e.g. https://careerx.ai
VITE_SERVER_URL=

# Firebase API key (only env var read from firebase.js — rest are hardcoded)
VITE_FIREBASE_APIKEY=your_firebase_api_key

# Razorpay public key
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
